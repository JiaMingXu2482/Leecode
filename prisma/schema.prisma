generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RecallRating {
  FORGOT
  SHAKY
  OK
  MASTERED
}

enum PlanItemKind {
  REVIEW
  RETEST
  NEW
}

enum SyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
}

model Problem {
  id                     String               @id @default(cuid())
  frontendId             Int                  @unique
  title                  String
  titleCn                String
  slug                   String               @unique
  leetcodeCnUrl          String
  difficulty             Difficulty
  tags                   String
  hot100Order            Int
  estimatedNewMinutes    Int
  estimatedReviewMinutes Int
  isEnabled              Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  progress               ProblemProgress?
  reviewSchedule         ReviewSchedule?
  sessions               StudySession[]
  planItems              PlanItem[]
  leetcodeSubmissions    LeetCodeSubmission[]
}

model ProblemProgress {
  id                  String        @id @default(cuid())
  problemId           String        @unique
  problem             Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  isAccepted          Boolean       @default(false)
  lastAcceptedAt      DateTime?
  lastSubmittedAt     DateTime?
  totalSubmissions    Int           @default(0)
  acceptedSubmissions Int           @default(0)
  acceptedRate        Int           @default(0)
  reviewRiskScore     Int           @default(0)
  mastery             RecallRating?
  noteIdea            String        @default("")
  notePitfall         String        @default("")
  noteComplexity      String        @default("")
  noteCodeLink        String        @default("")
  noteLastBlocker     String        @default("")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model ReviewSchedule {
  id                String   @id @default(cuid())
  problemId         String   @unique
  problem           Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  nextReviewDate    DateTime
  stage             Int      @default(0)
  consecutiveStrong Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StudySession {
  id              String       @id @default(cuid())
  problemId       String
  problem         Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  planItemId      String?      @unique
  planItem        PlanItem?    @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  kind            PlanItemKind
  rating          RecallRating
  feelingScore    Int?
  reviewAfterDays Int?
  spentMinutes    Int
  noteIdea        String       @default("")
  notePitfall     String       @default("")
  noteComplexity  String       @default("")
  noteCodeLink    String       @default("")
  noteLastBlocker String       @default("")
  noteMarkdown    String       @default("")
  noteSyntax      String       @default("")
  completedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())
}

model LeetCodeSubmission {
  id            String   @id @default(cuid())
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionId  String   @unique
  language      String   @default("")
  statusDisplay String   @default("")
  isAccepted    Boolean  @default(false)
  submittedAt   DateTime
  code          String   @default("")
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([problemId, submittedAt])
}

model Availability {
  id               String   @id @default(cuid())
  date             DateTime @unique
  isAvailable      Boolean  @default(true)
  availableMinutes Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AvailabilitySlot {
  id               String     @id @default(cuid())
  date             DateTime
  weekday          Int
  startTime        String
  endTime          String
  isAvailable      Boolean    @default(true)
  availableMinutes Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  planItems        PlanItem[]

  @@index([date])
}

model DailyPlan {
  id                    String     @id @default(cuid())
  date                  DateTime   @unique
  availableMinutes      Int
  totalEstimatedMinutes Int        @default(0)
  // When the auto-scheduler first filled this day's new-problem quota (and
  // carried debt). Once set, ensureTodayPlan never auto-adds new/carried items
  // to this day again, so the user's manual drags/removals are the last word.
  newFilledAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  items                 PlanItem[]
}

model PlanItem {
  id                 String            @id @default(cuid())
  dailyPlanId        String
  dailyPlan          DailyPlan         @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  availabilitySlotId String?
  availabilitySlot   AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)
  problemId          String
  problem            Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  kind               PlanItemKind
  estimatedMinutes   Int
  sortOrder          Int
  isCompleted        Boolean           @default(false)
  // Original planned date when the system auto-carried this unfinished NEW item
  // forward to today. Carried items stack on top of the per-day quota.
  carriedFromDate    DateTime?
  createdAt          DateTime          @default(now())
  session            StudySession?
}

model LeetCodeSyncState {
  id                String     @id @default("leetcode-cn")
  status            SyncStatus @default(IDLE)
  cookie            String     @default("")
  lastSyncedAt      DateTime?
  lastCodeSyncedAt  DateTime?
  lastError         String     @default("")
  lastCodeSyncError String     @default("")
  acceptedCount     Int        @default(0)
  checkedCount      Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// Personal ACM/机考 knowledge base: reusable code templates, I/O skeletons and
// pitfall notes. Separate from StudySession notes (which are per-problem logs) —
// this is a searchable reference the user copies from during a contest.
model AcmNote {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("输入输出")
  content   String   @default("")
  isPinned  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                  String    @id @default("default")
  appPasswordHash     String    @default("")
  defaultDailyMinutes Int       @default(150)
  targetDate          DateTime?
  // JSON array of TOPIC_GROUPS names whose new problems get scheduled first
  // (one per category per day). "" = never set → code default applies.
  priorityCategories  String    @default("")
  // Per-day new-problem quota; 0 = use the code default (NEW_PER_DAY).
  newPerDay           Int       @default(0)
  // Plan-assistant persona/behavior contract ("" = built-in default) and its
  // accumulated long-term memory of user preferences, one "- fact" per line.
  assistantSoul       String    @default("")
  assistantMemory     String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
